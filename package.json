{
  "name": "raileys",
  "version": "0.2.0",
  "description": "Baileys, but human readable and easy to use.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p . && node tests/run.mjs",
    "try": "npm run build && tsx examples/basic.ts",
    "start": "npm run build && node examples/basic.ts"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "easy"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "baileys": "^7.0.0-rc.6",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
